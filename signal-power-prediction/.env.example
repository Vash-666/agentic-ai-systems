# Data Provider API Keys
# Get free tier at: https://polygon.io
POLYGON_API_KEY=your_polygon_api_key_here

# Alternative: Alpaca Markets
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/signalpower
REDIS_URL=redis://localhost:6379/0

# Markets to Track (comma-separated symbols)
STOCKS=AAPL,MSFT,GOOGL,AMZN,TSLA
FOREX=EURUSD,GBPUSD,USDJPY
CRYPTO=BTCUSD,ETHUSD
INDICES=SPY,QQG,IWM

# Ingestion Settings
WEBSOCKET_RECONNECT_SECONDS=5
BATCH_SIZE=100
MAX_BUFFER_SIZE=1000

# Signal Processing
WAVELET_NAME=db4
WAVELET_LEVELS=5
KALMAN_PROCESS_NOISE=0.01
KALMAN_MEASUREMENT_NOISE=1.0

# Prediction
ENSEMBLE_LOOKBACK_DAYS=30
MIN_SIGNAL_POWER_THRESHOLD=0.3
CONFIDENCE_INTERVAL=0.95
